<Window x:Class="DownloadsStack.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DownloadsStack.Localization"
        Title="{Binding [Settings_Title], Source={x:Static loc:Loc.Text}}" Style="{StaticResource {x:Type Window}}" Background="Transparent" Foreground="{StaticResource TextBrush}" Width="520" SizeToContent="Height" MaxHeight="560" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="8" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
    </Window.Resources>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding [Settings_Heading], Source={x:Static loc:Loc.Text}}" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,10"/>
            <Border Grid.Row="1" MinHeight="54" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                <ListBox x:Name="FolderList" MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding Sources}" AutomationProperties.Name="{Binding [Settings_ListName], Source={x:Static loc:Loc.Text}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="0,1"/>
                    </Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource MutedBrush}" FontSize="15" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding ShowStatus, Converter={StaticResource BooleanVisibility}}"/>
                        </StackPanel>
                    </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <StackPanel Grid.Row="2">
                <!-- Damaged settings, an unwritable index or a failed shortcut had nowhere to be seen. -->
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#FF99A4" Margin="2,10,2,0"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanVisibility}}"/>
                <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#FF99A4" Margin="2,10,2,0">
                    <TextBlock.Style><Style TargetType="TextBlock">
                        <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,11,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <!-- Wrapping keeps every button at its natural width in long-worded languages. -->
                <WrapPanel x:Name="Actions">
                    <Button Content="{Binding [Settings_AddFolder], Source={x:Static loc:Loc.Text}}" Click="AddFolder"/>
                    <Button Content="{Binding [Settings_AddDownloads], Source={x:Static loc:Loc.Text}}" Click="AddDownloads" Visibility="{Binding CanAddDownloads, Converter={StaticResource BooleanVisibility}}"/>
                    <Button x:Name="RemoveButton" Content="{Binding [Settings_Remove], Source={x:Static loc:Loc.Text}}" Click="RemoveFolder" IsEnabled="False"/>
                    <Button Content="{Binding [Settings_Retry], Source={x:Static loc:Loc.Text}}" Click="Retry" Visibility="{Binding HasUnavailable, Converter={StaticResource BooleanVisibility}}"/>
                </WrapPanel>
                <Button Grid.Column="1" Content="{Binding [Settings_Done], Source={x:Static loc:Loc.Text}}" IsDefault="True" IsCancel="True" Click="Done" Style="{StaticResource AccentButton}" MinWidth="84" VerticalAlignment="Bottom"/>
            </Grid>
        </Grid>
    </Border>
</Window>
